# Node
node_modules/
**/node_modules/

# pnpm store (local caches)
.pnpm-store/
.pnpm/

# Keep pnpm lockfile tracked
# pnpm-lock.yaml

# Lock files for other managers (remove if switching)
package-lock.json
yarn.lock

# Build outputs
dist/
build/
out/
.cache/

# Coverage and test reports
coverage/
.nyc_output/
jest-report/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Env files
.env
.env.*                # ignore all env files except dedicated examples
!.env.example

# Editor/IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# TypeScript
*.tsbuildinfo

# Docker
docker-compose.override.yml

# Database / dumps
*.sqlite
*.sqlite3
*.sql
*.pgdump

# Misc
.DS_Store
Thumbs.db
tmp/
temp/
.history/
